# Copy to .env. The default demo does not call an external model.
ANTISENTINEL_PORT=8765
ANTISENTINEL_MODEL_MODE=fake
# For a real provider, set mode=real and fill in these values locally.
ANTISENTINEL_MODEL_BASE_URL=https://api.openai.com/v1
ANTISENTINEL_MODEL_NAME=gpt-4o-mini
ANTISENTINEL_MODEL_API_KEY=
ANTISENTINEL_MEMORY_VECTOR_ENABLED=0
DASHSCOPE_API_KEY=
ANTISENTINEL_EMBEDDING_BASE_URL=
